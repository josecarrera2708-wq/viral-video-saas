# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viral_db

# JWT / Authentication
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Kling API (Video generation)
KLING_API_KEY=your-kling-api-key
KLING_API_BASE_URL=https://api.kling.com/v1

# D-ID API (Fallback video generation)
DID_API_KEY=your-did-api-key
DID_API_BASE_URL=https://api.d-id.com

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_VIDEOS=viral-videos-prod
S3_BUCKET_UPLOADS=viral-uploads-temp

# Redis / Celery (for async tasks)
REDIS_URL=redis://localhost:6379/0

# Application
APP_NAME=Viral Video SaaS
DEBUG=True
MAX_UPLOAD_SIZE_MB=50
VIDEO_CREDIT_COST_PER_SEC=0.07
VIDEO_CREDIT_OVERHEAD=30
