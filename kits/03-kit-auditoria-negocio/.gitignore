# Config personal de cada ordenador — no se comparte ni se sube a git
.claude/settings.local.json

# Marcador que crea /setup en cada ordenador
.claude/setup-completado.json

# Formularios rellenos por clientes reales — no salen de este ordenador
entrada/*
!entrada/LEEME.md

# Auditorías: informes de negocios reales — no se distribuyen con el kit
workspace/*
!workspace/.gitkeep

# Basura del sistema
.DS_Store
